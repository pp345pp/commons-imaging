+                final int g = br.readBits(8);
+                final int r = br.readBits(8);
+                final int b = br.readBits(8);
+                final int a = br.readBits(8);
+                
+                final int argb = (a << 24) | (r << 16) | (g << 8) | b;
+                image.setRGB(x, y, argb);
+            }
+        }
+        
+        return image;
+    }
