+                bitCount[len]++;
+            }
+        }
+        int code = 0;
+        final int[] nextCode = new int[maxLength + 1];
+        for (int bits = 1; bits <= maxLength; bits++) {
+            code = (code + bitCount[bits - 1]) << 1;
+            nextCode[bits] = code;
+        }
